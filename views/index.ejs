<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Daily Trivia App</title>
  <!-- <link rel="shortcut icon" href="favicon.ico"> -->
  <link rel="stylesheet" href="font-awesome.min.css">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <h1>Daily Trivia</h1>
  <h2 id="questionLocation"></h2>


  <!-- <h3>Answers</h3> -->
  <ul class="chatMessages">
  <% for(var i=0; i<chatMessages.length; i++) {%>
    <li class="message">
      <span><%= chatMessages[i].name %></span>
      <span><%= chatMessages[i].msg %></span>
      <!-- <span><%= chatMessages[i].thumbUp %></span> -->
      <!-- <span><i class="fa fa-thumbs-up" aria-hidden="true"></i></span>
      <span><i class="fa fa-thumbs-down" aria-hidden="true"></i></span> -->
      <span><i class="fa fa-trash" aria-hidden="true"></i></span>
    </li>
  <% } %>
  </ul>

  <h2>Come Play the Game!</h2>
  <div class="inputs" id="inputs" >
  <input type="text" placeholder="Name" name="name" id="contestant">
  <input type="text" placeholder="Answer" name="msg" id="answer">
  <input type="text" placeholder="response" name="trueanswer" id="trueAnswer">
  <button id="submit">Submit</button>
  </div>
  <form action="/chatMessages" method="POST">
</form>

  <script src="main.js"></script>

</body>
</html>
